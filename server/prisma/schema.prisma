generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARTICIPANT
  PROGRAM_MANAGER
}

enum GoalStatus {
  ACTIVE
  ARCHIVED
}

enum ActivityUnit {
  MINUTES
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  emailNormalized String   @unique @map("email_normalized") @db.VarChar(254)
  displayName     String   @map("display_name") @db.VarChar(100)
  passwordHash    String   @map("password_hash")
  role            Role
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  sessions        Session[]
  templates       ActivityTemplate[]
  goals           Goal[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  csrfToken String   @map("csrf_token") @db.VarChar(64)
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("sessions")
}

model ActivityTemplate {
  id          String       @id @default(uuid()) @db.Uuid
  title       String       @db.VarChar(100)
  description String       @default("") @db.VarChar(500)
  unit        ActivityUnit @default(MINUTES)
  minMinutes  Int          @map("min_minutes")
  maxMinutes  Int          @map("max_minutes")
  isActive    Boolean      @default(true) @map("is_active")
  createdById String       @map("created_by_id") @db.Uuid
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  goals       Goal[]

  @@map("activity_templates")
}

model Goal {
  id                     String       @id @default(uuid()) @db.Uuid
  ownerId                String       @map("owner_id") @db.Uuid
  owner                  User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  templateId             String       @map("template_id") @db.Uuid
  template               ActivityTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateTitleSnapshot  String       @map("template_title_snapshot") @db.VarChar(100)
  unit                   ActivityUnit @default(MINUTES)
  minMinutesSnapshot     Int          @map("min_minutes_snapshot")
  maxMinutesSnapshot     Int          @map("max_minutes_snapshot")
  startDate              DateTime     @map("start_date") @db.Date
  endDate                DateTime?    @map("end_date") @db.Date
  status                 GoalStatus   @default(ACTIVE)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  targets                GoalTargetVersion[]
  entries                DailyEntry[]

  // Partial unique ACTIVE owner/template index is maintained in the SQL migration.
  @@index([ownerId, createdAt])
  @@map("goals")
}

model GoalTargetVersion {
  id            String   @id @default(uuid()) @db.Uuid
  goalId        String   @map("goal_id") @db.Uuid
  goal          Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime @map("effective_from") @db.Date
  targetMinutes Int      @map("target_minutes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([goalId, effectiveFrom])
  @@map("goal_target_versions")
}

model DailyEntry {
  id        String   @id @default(uuid()) @db.Uuid
  goalId    String   @map("goal_id") @db.Uuid
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  entryDate DateTime @map("entry_date") @db.Date
  minutes   Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([goalId, entryDate])
  @@map("daily_entries")
}
