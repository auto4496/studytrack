{
  "name": "studytrack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "tsc -p client/tsconfig.json && vite build",
    "start": "node server/dist/index.js",
    "db:up": "docker compose --profile test up -d db db-test",
    "db:migrate": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:seed": "tsx server/prisma/seed.ts",
    "db:test:migrate": "node scripts/test-database.mjs",
    "test": "vitest run",
    "test:unit": "vitest run server/tests/unit",
    "test:integration": "vitest run server/tests/integration",
    "test:e2e": "playwright test",
    "verify:restart": "tsx scripts/restart-smoke.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "setup:container": "node scripts/setup-container.mjs",
    "verify:container": "node scripts/verify-container.mjs",
    "container:up": "node scripts/container.mjs up",
    "container:stop": "node scripts/container.mjs stop",
    "container:status": "node scripts/container.mjs status"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.6",
    "prettier": "3.9.10",
    "prisma": "6.19.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
